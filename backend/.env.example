# 数据库配置
DATABASE_URL=sqlite:///./data/market.db

# Tushare Token (可选，用于 A股数据源备份)
TUSHARE_TOKEN=your_tushare_token_here

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=./logs

# 数据更新配置
DATA_UPDATE_ENABLED=true
DATA_UPDATE_TIME=15:30

# 服务器配置
HOST=0.0.0.0
PORT=8000

# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1   # 中转站/自建网关可改
# AI 模型分档（真正出投资建议用最强档，其余用便宜档）
OPENAI_BEST_MODEL=gpt-5.5
OPENAI_CHEAP_MODEL=gpt-5.4-mini

# 全局出网代理策略（OpenAI / websearch 等，让系统不死绑 Clash）
# auto(默认)=探测 Clash(127.0.0.1:7897) 在则走、不在则直连；direct=强制直连；或填具体代理 URL
HTTP_PROXY_MODE=auto

# 外置金融大脑 knowledge_engine（RAG 知识库 + 联网摄入）
KNOWLEDGE_DB_PATH=                          # 留空=backend/data/knowledge.db（独立于主库）
KNOWLEDGE_EMBED_MODEL=BAAI/bge-m3           # 本地 embedding 模型（中英双语，维度 1024）
KNOWLEDGE_EMBED_DIM=1024                    # 必须与模型一致，换模型需重建 vec_chunks 表
KNOWLEDGE_EMBED_DEVICE=mps                  # mps(Apple GPU)/cpu/cuda
KNOWLEDGE_CHUNK_TOKENS=512                  # 切片 token 数
KNOWLEDGE_CHUNK_OVERLAP=64                  # 切片重叠 token
KNOWLEDGE_SEARCH_QUERIES=                   # 摄入默认 query 列表（逗号分隔），可留空
KNOWLEDGE_EDGAR_UA=Fin Research Tool your_email@example.com  # SEC EDGAR 合规 UA（带邮箱）
KNOWLEDGE_SCRAPER_PROXY=                    # 可选强反爬专用代理，留空走 HTTP_PROXY_MODE
KNOWLEDGE_DDG_BASE_GAP=8.0                  # DuckDuckGo 限速间隔秒（防 202 软封）
KNOWLEDGE_WEBSEARCH_MAX_CHARS=20000         # read_url 正文截断字符数
KNOWLEDGE_RERANK=false                      # 检索重排（P2，暂未实现）

# 登录认证
AUTH_USERNAME=your_username_here
AUTH_PASSWORD=your_password_here
JWT_SECRET=your_jwt_secret_here

# EasyTrader 实盘配置（可选，需要运行券商客户端）
EASYTRADER_THS_PATH=                # 同花顺客户端路径
EASYTRADER_XQ_COOKIES=              # 雪球 cookies（雪球模式）
