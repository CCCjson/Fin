# 数据库配置
DATABASE_URL=sqlite:///./data/market.db

# Tushare Token (可选，用于 A股数据源备份)
TUSHARE_TOKEN=your_tushare_token_here

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=./logs

# 数据更新配置
DATA_UPDATE_ENABLED=true
DATA_UPDATE_TIME=15:30

# 服务器配置
HOST=0.0.0.0
PORT=8000

# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1   # 中转站/自建网关可改
# AI 模型分档（真正出投资建议用最强档，其余用便宜档）
OPENAI_BEST_MODEL=gpt-5.5
OPENAI_CHEAP_MODEL=gpt-5.4-mini

# 全局出网代理策略（OpenAI / websearch 等，让系统不死绑 Clash）
# auto(默认)=探测 Clash(127.0.0.1:7897) 在则走、不在则直连；direct=强制直连；或填具体代理 URL
HTTP_PROXY_MODE=auto

# 海外出口代理（Shadowrocket，Clash 已弃用）——爬海外站/DDG/OpenAI 时用
KNOWLEDGE_OVERSEAS_MODE=auto                # auto=先探本地能否直连海外,不通才走代理；direct=强制直连；proxy=强制走代理
KNOWLEDGE_OVERSEAS_PROXY=http://127.0.0.1:7898  # Shadowrocket 本地出口，auto/proxy 模式下直连不通时的兜底

# 外置金融大脑 knowledge_engine（RAG 知识库 + 联网摄入）
KNOWLEDGE_DB_PATH=                          # 留空=backend/data/knowledge.db（独立于主库）
KNOWLEDGE_EMBED_MODEL=BAAI/bge-m3           # 本地 embedding 模型（中英双语，维度 1024）
KNOWLEDGE_EMBED_DIM=1024                    # 必须与模型一致，换模型需重建 vec_chunks 表
KNOWLEDGE_EMBED_DEVICE=mps                  # mps(Apple GPU)/cpu/cuda
KNOWLEDGE_CHUNK_TOKENS=512                  # 切片 token 数
KNOWLEDGE_CHUNK_OVERLAP=64                  # 切片重叠 token
KNOWLEDGE_SEARCH_QUERIES=                   # 摄入默认 query 列表（逗号分隔），可留空
KNOWLEDGE_EDGAR_UA=Fin Research Tool your_email@example.com  # SEC EDGAR 合规 UA（带邮箱）
KNOWLEDGE_SCRAPER_PROXY=                    # 可选强反爬专用代理，留空走 HTTP_PROXY_MODE
KNOWLEDGE_DDG_BASE_GAP=8.0                  # DuckDuckGo 限速间隔秒（防 202 软封）
KNOWLEDGE_WEBSEARCH_MAX_CHARS=20000         # read_url 正文截断字符数
KNOWLEDGE_RERANK=false                      # 检索重排（P2，暂未实现）

# 登录认证
AUTH_USERNAME=your_username_here
AUTH_PASSWORD=your_password_here
JWT_SECRET=your_jwt_secret_here             # 强随机值，如 `openssl rand -hex 32`；仍为占位值时强制鉴权会拒绝启动
AUTH_ENFORCE=on                              # 全局 JWT 鉴权开关，off=紧急回滚（仅限本机可信调试，见 api/deps.py）

# EasyTrader 实盘配置（可选，需要运行券商客户端）
EASYTRADER_THS_PATH=                # 同花顺客户端路径
EASYTRADER_XQ_COOKIES=              # 雪球 cookies（雪球模式）

# OpenCTP / SimNow 测试交易凭证（不要提交真实值）
OPENCTP_BROKER_ID=9999
OPENCTP_USER_ID=
OPENCTP_PASSWORD=
OPENCTP_APP_ID=simnow_client_test
OPENCTP_AUTH_CODE=0000000000000000

# Newnew 新闻模块自动化（定时抓取国内外新闻 + BERT情感 + LLM结论 + 高影响预警）
NEWS_AUTO_FETCH_ENABLED=true                # 开机自启定时抓取，false 则只手动跑 /news/job/run-once
NEWS_FETCH_INTERVAL_MINUTES=15              # 抓取周期（分钟）
NEWS_CACHE_CLEAR_CRON=0 4 * * 1             # 每周清一次内存去重前置缓存（周一 04:00），不影响历史数据
NEWS_ENABLE_WEBSEARCH=true                  # 综合新闻是否额外用 DuckDuckGo 联网搜索补充头条，DDG 被限速/软封时可关
# 高影响预警关键词已挪到 backend/configs/news_high_impact_keywords.json（分类JSON，改了立即生效，不用重启）
NEWS_MAC_NOTIFY_ENABLED=true                # 高影响预警是否弹 macOS 系统通知（仅本机跑 backend 时生效）

# MoneyBill agent 语料留痕（供将来微调/蒸馏本地模型或压测评估用，默认全开）
AGENT_TRACE=on                               # turn 级 trace，落 data/agent_traces/{session_id}.jsonl（回灌 LLM 的 summary 版本）
AGENT_TRACE_RAW=on                           # 工具原始未截断返回，落 data/agent_traces_raw/{session_id}.jsonl（history 压缩前的原文）
AGENT_TRACE_MAX_AGE_DAYS=14                  # trace 文件保留天数，超期自动清理（写 trace 时节流触发，见 agents/trace.py）
AGENT_SESSION_PERSIST=on                     # 会话 messages 落盘 data/agent_sessions/，保留 14 天
NEWS_NOTIFY_OPEN_URL=                        # 新闻源没带原文链接时的兜底跳转地址；留空=点击唤起 Fin App（需装 terminal-notifier 才生效）

# MoneyBill agent 运行时行为开关（均可 off/0/false 关闭，默认全开）
AGENT_TOOL_GROUPS=on                         # 工具分组按需加载（核心常驻+按页预载+模型自助 load_toolgroup），off=全量暴露
AGENT_TURN_MONITOR=on                        # 工具调用流程监控总开关（重复拦截/连败纠偏/预算提醒/轮中压缩/硬熔断）
AGENT_TM_INTERVENE=on                        # 细粒度：off 时 TurnMonitor 只观测不干预（拦截/注入/压缩/熔断全跳过）
AGENT_TM_SOFT_TOKENS=50000                   # 单 turn 软预算：超过提醒模型尽快收敛
AGENT_TM_COMPACT_TOKENS=60000                # 单 turn 轮中压缩起跳线：超过开始截短早期工具结果
AGENT_TM_COMPACT_STEP=30000                  # 轮中压缩节流步长：每再涨这么多 token 才可再压一次
AGENT_TM_HARD_TOKENS=120000                  # 单 turn 硬预算：超过强制无工具收尾（熔断）
AGENT_TM_BAD_STREAK=3                        # 连续几次失败/空结果/重复调用后触发纠偏提示
AGENT_TM_DUP_TTL_S=120                       # 实时类工具（行情等）重复调用的刷新间隔秒数
AGENT_POLICY_CHECK=on                        # 收尾前代码校验：股票代码须有本轮工具调用背书、subagent 收尾不许长复述
AGENT_DEEP_STOCK_V2=on                       # run_deep_stock 用窄工具集 mini-ReAct（off 回退到 v1 一次性长 prompt 版）
# AGENT_PRICE__<model>=<input每百万token美元>,<output每百万token美元>  按需覆盖单价，如：
# AGENT_PRICE__gpt-5.5=5.00,30.00
# AGENT_PRICE__gpt-5.4-mini=0.75,4.50
